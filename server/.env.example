# LLM
OPENROUTER_API_KEY=

# Web search (Serper — used for company research + hiring manager lookup)
SERPER_API_KEY=

# Database
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=jobhub-achievements

# Sentry
SENTRY_DSN=

# App config
NODE_ENV=production
DEV_BYPASS_AUTH=false
MAX_DAILY_GENERATIONS=10
ALLOWED_ORIGIN=https://your-app.vercel.app
PORT=3002

# Live workshop
# The schedule is recurring: a weekday plus a wall-clock time, re-derived on
# every request. Moving the workshop is a variable change, not a deploy.
WORKSHOP_DAY=tuesday
WORKSHOP_TIME=17:00
WORKSHOP_TZ=Australia/Sydney
WORKSHOP_DURATION_MINUTES=90
WORKSHOP_REMINDER_MINUTES=20
WORKSHOP_MEET_LINK=
WORKSHOP_TITLE=
# Pins one off-cycle session to an exact instant and turns the weekly roll OFF.
# Needs an explicit offset. Leave EMPTY for normal weekly operation.
WORKSHOP_START=
# Branded redirect to the free Skool group, so the destination can move and the
# click stays attributable. Point it at /community, not at skool.com.
SKOOL_GROUP_URL=https://aussiegradcareers.com.au/community
# Guards the roster export, which returns names, emails and full resume text.
# There is NO fallback: unset disables the endpoint. Generate a fresh one with
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SESSION_EXPORT_KEY=

# Admin "PAID BUT UNMATCHED" alerts: off (default) | once | weekly.
# Off means the nightly sweep still records and logs unmatched payers, it just
# does not email about them. See src/config/alerts.ts.
UNMATCHED_PAYMENT_ALERTS=off

# Speech to text for the answer bank intake (AssemblyAI).
ASSEMBLYAI_API_KEY=

# Pause a client's access automatically the moment an installment fails, instead
# of only when you place a hold by hand. Off by default: whether a bounced
# payment should cost someone access is a coaching call, not a billing one.
# Turn it ON if unpaid clients are coasting on full access while they sort out
# a card. Access restores by itself as soon as the payment clears.
#   Manage holds:  npx tsx src/scripts/billing_hold.ts status|place|lift
BILLING_HOLD_ON_FAILURE=false
