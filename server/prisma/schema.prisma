generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CandidateProfile {
  id                           String            @id @default(uuid())
  userId                       String            @unique
  name                         String?
  email                        String?           @unique
  /// When the "add this buyer to Skool Premium" task was raised. Skool has no
  /// API, so the grant itself is a manual toggle; this exists so a Stripe
  /// webhook retry cannot raise the same task twice. An admin task that arrives
  /// three times is one that stops being read.
  skoolUpgradeNotifiedAt       DateTime?
  phone                        String?
  linkedin                     String?
  location                     String?
  professionalSummary          String?
  skills                       String?
  coachingAlerts               Json?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  applicationsCount            String?
  channels                     Json?
  coverLetterRawText           String?
  coverLetterRawText2          String?
  hasCompletedOnboarding       Boolean           @default(false)
  industry                     String?
  perceivedBlocker             String?
  responsePattern              String?
  resumeRawText                String?
  // The untouched text of the file they uploaded. resumeRawText holds the CLEAN
  // rebuilt resume that every generation grounds on, so we keep the original
  // here for diffing and recovery. Never overwrite this once set.
  resumeOriginalText           String?
  searchDuration               String?
  seniority                    String?
  yearsOfExperience            Int?
  targetCity                   String?
  targetRole                   String?
  targetRoles                  Json?
  marketingConsent             Boolean           @default(false)
  marketingEmail               String?
  marketingEmailSent           Boolean           @default(false)
  visaStatus                   String?
  dashboardAccess              Boolean           @default(false)
  dashboardAccessRequested     Boolean           @default(false)
  skoolJoined                  Boolean           @default(false)
  skoolCommunityEmail          String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  subscriptionStatus     String?
  plan                   String    @default("free")
  planStatus             String    @default("active")
  trialEndDate           DateTime?
  accessExpiresAt        DateTime?
  freeGenerationsUsed    Int       @default(0)
  freeAnalysesUsed       Int       @default(0)
  freeJobSearchesUsed    Int       @default(0)
  freeMatchScoresUsed    Int       @default(0)
  achievementCountAtDerivation Int?
  identityCards                Json?
  identityCardsUpdatedAt       DateTime?
  profileAdvisorCallsToday     Int               @default(0)
  profileAdvisorCallsDate      DateTime?
  headshotUrl                  String?
  headshotGenerationsToday     Int               @default(0)
  headshotGenerationsDate      DateTime?
  resumeFilename               String?
  coverLetterFilename          String?
  coverLetterFilename2         String?
  dailyApplicationGoal         Int       @default(5)
  applicationGoalType          String    @default("daily")
  dailyOutreachGoal            Int       @default(4)
  outreachGoalType             String    @default("daily")
  documentsUpdatedAt           DateTime?
  // When we last sent this candidate a follow-up nudge email. Throttles the
  // reminder to one per person every 4 days instead of one per application.
  lastFollowUpNudgeAt          DateTime?
  positioningStatement         Json?
  analysisCache                Json?
  achievements                 Achievement[]
  certifications               Certification[]
  diagnosticReport             DiagnosticReport?
  education                    Education[]
  experience                   Experience[]
  jobApplications              JobApplication[]
  jobFeedItems                 JobFeedItem[]
  languages                    Language[]
  resumeVersions               ResumeVersion[]
  volunteering                 Volunteering[]
  contactId                    String?   @unique
  contact                      Contact?       @relation(fields: [contactId], references: [id])
}

model ResumeVersion {
  id                 String           @id @default(cuid())
  userId             String
  candidateProfileId String
  label              String
  rawText            String?
  createdAt          DateTime         @default(now())
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
}

model Experience {
  id                 String           @id @default(uuid())
  candidateProfileId String
  company            String
  role               String
  startDate          String
  endDate            String?
  isCurrent          Boolean          @default(false)
  isCasual           Boolean          @default(false)
  type               String           @default("work")
  description        String?
  coachingTips       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  achievements       Achievement[]
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Education {
  id                 String           @id @default(uuid())
  candidateProfileId String
  institution        String
  degree             String
  field              String?
  startDate          String?
  endDate            String?
  year               String?
  location           String?
  coachingTips       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Volunteering {
  id                 String           @id @default(uuid())
  candidateProfileId String
  organization       String
  role               String
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Certification {
  id                 String           @id @default(uuid())
  candidateProfileId String
  name               String
  issuingBody        String
  year               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Language {
  id                 String           @id @default(uuid())
  candidateProfileId String
  name               String
  proficiency        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
}

model Achievement {
  id                 String           @id @default(uuid())
  userId             String
  candidateProfileId String
  experienceId       String?
  title              String
  description        String
  metric             String?
  metricType         String?
  industry           String?
  skills             String?
  tags               String?
  isStaged           Boolean          @default(false)
  coachingTips       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  experience         Experience?      @relation(fields: [experienceId], references: [id])
}

model JobApplication {
  id                  String            @id @default(uuid())
  userId              String
  candidateProfileId  String
  title               String
  company             String
  description         String
  sourceUrl           String?
  dateApplied         DateTime?
  status              ApplicationStatus @default(SAVED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  notes               String?
  priority            JobPriority?
  closingDate         DateTime?
  blueprintJson       Json?
  australianFlags     Json?
  dimensions          Json?
  matchedIdentityCard String?
  overallGrade        String?
  followUpSentAt      DateTime?
  followUpDismissedAt DateTime?
  interviewReachedAt  DateTime?
  offerReachedAt      DateTime?
  companyIntel        Json?
  documents           Document[]
  candidateProfile    CandidateProfile  @relation(fields: [candidateProfileId], references: [id])

  @@index([userId])
  @@index([candidateProfileId])
}

enum OutreachStatus {
  ACTIVE
  REPLIED
  CALL_BOOKED
  REFERRAL
  CLOSED_NO_REPLY
  CLOSED_MANUAL
}

model OutreachLog {
  id               String            @id @default(uuid())
  userId           String
  personName       String
  company          String
  topic            String
  specificQuestion String            @default("")
  firstMessage     String            @default("")
  status           OutreachStatus    @default(ACTIVE)
  createdAt        DateTime          @default(now())
  messages         OutreachMessage[]

  // Draft bodies for the five generated templates. Kept separate from
  // OutreachMessage (which records what was actually sent) so a user can log
  // at connection-request time and come back to the drafts days later, once
  // the person accepts. Without these, closing the tab lost the drafts.
  connectionNote   String            @default("")
  followUpDraft    String            @default("")
  directAskDraft   String            @default("")
  // The 3-4 week re-contact: arrives long after the thread went quiet, asks
  // for nothing, and reports something the candidate actually did off the back
  // of the person's advice. Most referrals come from this message, not the call.
  reContactDraft   String            @default("")
  draftsUpdatedAt  DateTime          @default(now())

  @@index([userId])
}

model OutreachMessage {
  id            String      @id @default(uuid())
  outreachLogId String
  touchNumber   Int
  body          String
  copiedAt      DateTime    @default(now())
  outreachLog   OutreachLog @relation(fields: [outreachLogId], references: [id], onDelete: Cascade)

  @@unique([outreachLogId, touchNumber])
  @@index([outreachLogId])
}

model JobFeedItem {
  id                   String           @id @default(uuid())
  userId               String
  feedDate             DateTime         @db.Date
  title                String
  company              String
  location             String?
  salary               String?
  description          String
  bullets              Json?
  sourceUrl            String
  sourcePlatform       String
  postedAt             DateTime?
  suggestedAddressee   String?
  addresseeTitle       String?
  addresseeConfidence  String?
  addresseeSource      String?
  matchScore           Int?
  matchDetails         Json?
  isRead               Boolean          @default(false)
  isSaved              Boolean          @default(false)
  skipped              Boolean          @default(false)
  skippedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  candidateProfile     CandidateProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, feedDate])
}

model SkippedJob {
  id        String    @id @default(uuid())
  userId    String
  sourceUrl String
  title     String
  company   String
  location  String?
  postedAt  DateTime?
  skippedAt DateTime  @default(now())

  @@unique([userId, sourceUrl])
  @@index([userId, skippedAt])
}

model SeekJobCache {
  id          String   @id @default(cuid())
  queryHash   String
  queryMeta   Json
  feedDate    String
  results     Json
  resultCount Int
  fetchedAt   DateTime @default(now())

  @@unique([queryHash, feedDate])
  @@index([feedDate])
}

model Document {
  id               String             @id @default(uuid())
  userId           String
  title            String?
  jobApplicationId String?
  type             DocumentType
  content          String
  edited           Boolean            @default(false)
  templateConfig   Json?
  qualitySignals   Json?
  // Fingerprint of the advert this document was generated against. Generation
  // and the tracker row are created by two separate calls, so without this
  // there is nothing to join them on and the document stays orphaned, which
  // is why 97% of them had no application attached.
  jobDescriptionHash String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  jobApplication   JobApplication?    @relation(fields: [jobApplicationId], references: [id])
  feedback         DocumentFeedback[]
  qcReviews        DocumentQcReview[]

  @@index([userId])
  @@index([jobApplicationId])
  @@index([userId, jobDescriptionHash])
}

// A coach's spot-check of one generated document, cached against a hash of
// everything the judge was shown. Editing the document, repairing its job
// description or re-uploading the client's resume changes the hash and earns a
// fresh verdict; nothing else does, so re-opening a document is free.
model DocumentQcReview {
  id           String   @id @default(uuid())
  documentId   String
  contentHash  String
  verdict      Json
  model        String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  reviewedBy   String?
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, contentHash])
  @@index([documentId])
}

model DocumentFeedback {
  id           String       @id @default(uuid())
  documentId   String
  userId       String
  rating       Int
  documentType DocumentType
  weakSection  String?
  freeText     String?
  createdAt    DateTime     @default(now())
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DiagnosticReport {
  id               String                     @id @default(uuid())
  userId           String                     @unique
  status           DiagnosticStatus           @default(PROCESSING)
  intakeAnswers    Json
  reportMarkdown   String?
  overallRating    Int?
  ratingChips      String[]
  ratingComment    String?
  ratedAt          DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  candidateProfile CandidateProfile           @relation(fields: [userId], references: [userId])
  feedback         DiagnosticReportFeedback[]
}

model DiagnosticReportFeedback {
  id             String           @id @default(uuid())
  reportId       String
  sectionKey     String
  relevanceScore String
  createdAt      DateTime         @default(now())
  report         DiagnosticReport @relation(fields: [reportId], references: [id])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  REJECTED
  OFFER
}

enum DocumentType {
  RESUME
  COVER_LETTER
  STAR_RESPONSE
  BASELINE_RESUME
  INTERVIEW_PREP
}

enum JobPriority {
  DREAM
  TARGET
  BACKUP
}

enum DiagnosticStatus {
  PROCESSING
  COMPLETE
  FAILED
}

// Which Home Affairs list a sponsor appears on. Accredited sponsors get priority
// visa processing, so this is the strongest "apply here first" signal we can show.
// Declared accredited-first so `orderBy tier asc` floats them to the top.
enum SponsorTier {
  accredited
  standard
}

model FridayBrief {
  id          String   @id @default(uuid())
  windowStart DateTime @unique
  windowEnd   DateTime
  script      String
  reportCount Int
  generatedAt DateTime @default(now())
}

model Sponsor {
  id               String             @id @default(uuid())
  cleanName        String             @unique
  rawName          String
  website          String?
  careersUrl       String?
  careersSearchUrl String?
  // Nullable: the ~33k standard-tier sponsors arrive as a bare company name off the
  // Home Affairs list. Null means "not enriched yet", which the UI hides. Storing ''
  // instead would render as an empty chip and read as "no industry".
  industry         String?
  locations        String[]
  hiringProfile    String?
  tier             SponsorTier        @default(standard)
  // From the ABN Bulk Extract (ABR, free). Null where the sponsor's name on the
  // Home Affairs list could not be matched to an ABR entity.
  abn              String?
  state            String?
  postcode         String?
  // The name the business trades under, where the ABR holds one and it differs from
  // the registered name. For the ~3.4k sponsors registered as a trust this is the
  // only human-meaningful name we have: 'THE TRUSTEE FOR A & J GANDHI FAMILY TRUST'
  // is really 'BOMBAY BY NIGHT'.
  tradingName      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([industry])
  @@index([tier])
  @@index([state])
  @@index([cleanName])
}

model CvScanLead {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String?
  fullName     String?
  inferredRole String?
  score        Int?
  createdAt    DateTime @default(now())
}

model SponsorLead {
  id         String   @id @default(uuid())
  email      String   @unique
  createdAt  DateTime @default(now())
  unlockedAt DateTime @default(now())
}

model SponsorJob {
  id                String   @id @default(uuid())
  sourceUrl         String   @unique
  title             String
  company           String
  normalizedCompany String
  location          String?
  salary            String?
  description       String
  sourcePlatform    String
  postedAt          DateTime?
  confidence        String
  employerMatched   Boolean
  sponsorCleanName  String?
  positivePhraseHit Boolean
  negationPhraseHit Boolean
  matchedPhrases    Json?
  scanQuery         String
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @updatedAt
  feedDate          String

  @@index([confidence])
  @@index([normalizedCompany])
  @@index([feedDate])
}

model Contact {
  id              String    @id @default(uuid())
  email           String    @unique
  firstName       String?
  lastName        String?
  source          String    @default("manual")
  metadata        Json?
  emailOptIn      Boolean   @default(true)
  unsubscribedAt  DateTime?
  lastActivityAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags              ContactTag[]
  sequences         ContactSequence[]
  emailSends        EmailSend[]
  notes             ContactNote[]
  candidateProfile  CandidateProfile?
}

model ContactNote {
  id        String   @id @default(uuid())
  contactId String
  content   String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  label     String?
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([contactId, tagId])
  @@index([tagId])
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  bodyText  String?
  bodyHtml  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps     SequenceStep[]
  emailSends  EmailSend[]
}

model EmailSequence {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  priority    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps SequenceStep[]
  contactSequences  ContactSequence[]
  emailSends        EmailSend[]
}

model SequenceStep {
  id         String   @id @default(uuid())
  sequenceId String
  stepOrder  Int
  delayDays  Int
  templateId String
  createdAt  DateTime @default(now())

  sequence EmailSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template EmailTemplate  @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId])
  @@index([templateId])
}

model ContactSequence {
  id                String    @id @default(uuid())
  contactId         String
  sequenceId        String
  currentStep       Int       @default(0)
  completed         Boolean   @default(false)
  lastStepSentAt    DateTime?
  enrolledAt        DateTime  @default(now())
  completedAt       DateTime?
  unenrolledAt      DateTime?
  unenrolledReason  String?

  contact  Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([contactId, sequenceId])
  @@index([contactId, currentStep, completed])
}

model EmailSend {
  id              String   @id @default(uuid())
  contactId       String
  sequenceId      String?
  sequenceStepId  String?
  templateId      String?
  broadcastId     String?
  resendEmailId   String?
  subject         String
  fromEmail       String
  toEmail         String
  sentAt          DateTime @default(now())

  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequence    EmailSequence?  @relation(fields: [sequenceId], references: [id])
  template    EmailTemplate?  @relation(fields: [templateId], references: [id])
  opens       EmailOpen[]
  clicks      EmailClick[]

  @@index([contactId, sentAt])
  @@index([sentAt])
}

model EmailOpen {
  id          String   @id @default(uuid())
  emailSendId String
  openedAt    DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)
  @@index([emailSendId])
}

model EmailClick {
  id          String   @id @default(uuid())
  emailSendId String
  url         String
  clickedAt   DateTime @default(now())
  userAgent   String?
  ipAddress   String?

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)
  @@index([emailSendId])
}

model Broadcast {
  id        String   @id @default(uuid())
  name      String
  subject   String
  bodyText  String?
  bodyHtml  String?
  targetCriteria Json?
  status    String   @default("draft")
  sentAt    DateTime?
  createdAt DateTime @default(now())
}

model Job {
  id                  String      @id @default(uuid())
  dedupKey            String      @unique
  title               String
  company             String
  normalizedCompany   String
  location            String?
  locationKey         String?
  salary              String?
  workMode            String?
  description         String
  descriptionHydrated Boolean     @default(false)
  postedAt            DateTime?
  relevanceScore      Float       @default(0)
  lowRelevance        Boolean     @default(false)
  searchRole          String
  firstSeenAt         DateTime    @default(now())
  lastSeenAt          DateTime    @updatedAt
  feedDate            String
  sources             JobSource[]
  @@index([normalizedCompany])
  @@index([feedDate])
  @@index([lowRelevance])
  @@index([searchRole, locationKey, feedDate])
}

model JobSource {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      String
  sourceUrl   String
  sourceJobId String?
  seenAt      DateTime @default(now())
  @@unique([source, sourceUrl])
  @@index([jobId])
}

model IngestionRun {
  id         String         @id @default(uuid())
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  trigger    String
  totalRaw   Int            @default(0)
  totalNew   Int            @default(0)
  totalDup   Int            @default(0)
  results    SourceResult[]
}

model BookingIntake {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  linkedinUrl      String?
  currentRole      String?
  targetRole       String?
  visaStatus       String?
  biggestChallenge String?
  resumeText       String?
  calendlyEventId  String?
  callScheduledAt  DateTime?
  battleCard       String?
  battleCardAt     DateTime?
  obsidianSynced   Boolean   @default(false)
  createdAt        DateTime  @default(now())
}

model SourceResult {
  id           String       @id @default(uuid())
  runId        String
  run          IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  source       String
  query        String
  status       String
  rawCount     Int          @default(0)
  newCount     Int          @default(0)
  dupCount     Int          @default(0)
  uniqueCount  Int          @default(0)
  blocked      Boolean      @default(false)
  errorMessage String?
  latencyMs    Int          @default(0)
  creditsUsed  Int          @default(0)
  @@index([runId])
  @@index([source])
}


model GoalChange {
  id               String    @id @default(uuid())
  userId           String
  appGoal          Int
  appGoalType      String
  outreachGoal     Int
  outreachGoalType String
  effectiveAt      DateTime
  appliedAt        DateTime?
  byCoach          Boolean   @default(false)
  note             String?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, effectiveAt])
}

model PauseWeek {
  id        String   @id @default(uuid())
  userId    String
  weekStart DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

enum LocalExperienceType {
  VOLUNTEERING
  TEMP_WORK
  INTERNSHIP
  PART_TIME
  PROJECT
  COMMUNITY
  OTHER
}

model LocalExperienceEntry {
  id           String              @id @default(uuid())
  userId       String
  type         LocalExperienceType
  organisation String
  role         String
  description  String              @default("")
  hoursPerWeek Int?
  startedAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model NudgeLog {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  periodKey String
  sentAt    DateTime @default(now())

  @@unique([userId, kind, periodKey])
}

// One anonymous run through /welcome. The entire resume rebuild (analysis,
// questions, answers, the finished clean resume) happens BEFORE we ask for an
// email, so it cannot live in an in-memory map: a Railway redeploy mid-flow
// would throw away work the visitor spent ten minutes on. Rows are claimed at
// /welcome/finish and swept after 7 days.
model WelcomeSession {
  id                 String   @id @default(uuid())
  token              String   @unique
  resumeOriginalText String
  resumeFilename     String?
  firstName          String?
  currentRole        String?
  brief              String?
  questions          Json?
  answers            Json?
  // What the raw file contains that text extraction drops (photo, images).
  signals            Json?
  // Inventory the rebuild is verified against before it may become the truth.
  mustKeep           Json?
  resumeCleanText    String?
  // Rebuilds attempted on this session. /welcome/build is anonymous and costs an
  // LLM call, so it is capped per session rather than left open.
  buildCount         Int      @default(0)
  claimedByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdAt])
}

/// One person registering for a live group session.
///
/// `answers` is a JSON blob keyed by question id rather than a column per
/// question on purpose: the qualifying questions change from session to
/// session, and a new question must never mean a new migration on the day of
/// the call. The export endpoint flattens whatever keys it finds.
model SessionRegistration {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  phone  String?

  answers Json

  /// The question list as it stood when they answered: { id: { label, type } }.
  /// Stored per row so the export can label and aggregate correctly even after
  /// the questions are rewritten for the next session, and so it never has to
  /// guess a question's type from the shape of the answers.
  questionSchema Json?

  resumeText     String?
  resumeFilename String?
  /// The original bytes. Kept because the ATS structural check has to inspect
  /// the real document: a DOCX is a zip of XML, and its text boxes and tables
  /// are invisible once the file has been flattened to text. Capped at 5MB by
  /// the upload middleware.
  resumeFile     Bytes?
  resumeMimetype String?
  /// Set only when they take the "I can't upload right now" escape. Their
  /// reason is kept because it is itself a qualifying signal.
  resumeSkipReason String?

  /// Which session this registration is for, so one table serves every future
  /// call without the export mixing them up.
  sessionKey String @default("2026-08-06")

  /// Set when the pre-workshop reminder goes out, so a cron that ticks every
  /// couple of minutes cannot send it twice.
  reminderSentAt DateTime?

  /// Set when they claim the link dropped in the Meet chat partway through the
  /// session. Only people in the room see that link, so this IS the attendance
  /// record. Nothing else tells us who actually turned up.
  attendedAt DateTime?

  /// The generated diagnostic, stored whole. The report page reads this rather
  /// than re-running the scan: a re-run costs two more LLM calls and would show
  /// them something different from what they were emailed.
  report            Json?
  /// The only credential on the report URL. Unguessable, and per person.
  reportToken       String?   @unique
  reportGeneratedAt DateTime?
  reportSentAt      DateTime?
  /// Last failure, kept so a stuck row is visible instead of silently retrying
  /// forever.
  reportError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionKey, createdAt])
  @@index([attendedAt, reportGeneratedAt])
}

/// A Stripe payment the reconciliation sweep could not tie to a JobHub
/// account. Exists so the nightly sweep has a memory: without it the same
/// unresolved payer generated a fresh admin alert every single night.
model UnmatchedPayment {
  id               String    @id @default(uuid())
  email            String    @unique
  plan             String?
  amount           Float?
  /// Human-readable Stripe provenance, e.g. "one-off charge ch_123 ($500.00)".
  reason           String?
  stripeCustomerId String?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  /// When the admin was last emailed about this payer. Drives the re-nag
  /// interval so an unresolved payer is raised weekly, not nightly.
  alertedAt   DateTime?
  alertCount  Int       @default(0)
  /// Set the moment the sweep finds a matching profile. Never alerted again.
  resolvedAt  DateTime?

  @@index([resolvedAt, alertedAt])
}

/// The sales pipeline, moved off the local Python CRM and onto the same
/// database as everything else.
///
/// One row per person, whether they arrived from a LinkedIn import or walked in
/// through a /free/ page. Keeping imported leads and funnel registrations in one
/// table is the whole point: two lists meant two places to look and a person who
/// existed in both was invisible as the same person.
///
/// The stage is DERIVED from signals, not typed by hand. Registered, attended
/// and paid are all facts the system already records, so a stage that has to be
/// dragged is a stage that goes stale. Only Dead is set manually.
model SalesLead {
  id    String  @id @default(cuid())
  name  String
  /// The join key across the CRM, JobHub and Stripe. Nullable because an
  /// imported LinkedIn lead may have nothing but a profile URL.
  email String? @unique
  phone String?

  linkedinUrl String?
  headline    String?
  company     String?

  /// Lead, Registered, Attended, Pitched, Client, Dead.
  stage  String @default("Lead")
  /// Where they came from: linkedin-import, free-resource, session.
  source String @default("linkedin-import")
  /// Which free asset brought them in, when that is how they arrived.
  sourceAsset String?

  /// Hidden from the board by default. Set for imported leads carrying neither
  /// an email nor a resume: there is no way to contact them and nothing to work
  /// with, so they are noise on a board that has to stay readable.
  archived Boolean @default(false)

  /// Funnel signals, denormalised so the board is one query rather than four.
  registeredAt DateTime?
  attendedAt   DateTime?
  reportSentAt DateTime?
  paidAt       DateTime?

  /// When they clicked through to the Skool group, from any surface carrying
  /// their lead id.
  ///
  /// ⚠️ A CLICK, NOT A JOIN. Skool has no API, so nothing here can tell you
  /// whether they actually signed up on the other side. Treat it as intent.
  /// The only proof of membership is Skool's own member list, matched on email
  /// by hand. Do not rename this to skoolJoinedAt and do not derive a stage
  /// from it: a board that claims a join it cannot see is worse than a blank.
  skoolClickedAt DateTime?

  /// True when a resume is on file, wherever it came from.
  hasResume Boolean @default(false)

  notes    String?
  nextBest String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived, stage])
  @@index([updatedAt])
}
