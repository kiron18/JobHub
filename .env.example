VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://your-backend.railway.app/api
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Free Skool group, the destination behind /community
VITE_SKOOL_GROUP_URL=https://www.skool.com/touch-grass-5787/about

# Stripe payment link the report CTA sends people to
VITE_CHECKOUT_URL=https://buy.stripe.com/9B6bJ37d49YJ2o23psfMA04

# In-page Stripe checkout, in the offer card instead of a redirect to Stripe.
# Both are needed: the flag alone with no key would take the redirect away and
# put nothing back, so the code falls back to the redirect unless both are set.
#
# These are BROWSER variables and Vite compiles them into the bundle at build
# time, so they belong wherever the FRONTEND is built (Vercel), not on Railway.
# Vercel will warn that the VITE_ prefix exposes the value to the browser. That
# is the point: a publishable key is public by design and Stripe puts it in
# every page that mounts checkout. Keep the prefix.
#
# pk_, never sk_. STRIPE_SECRET_KEY and WEBHOOK_SECRET are server-only and must
# never be given a VITE_ name, because every VITE_ value is served to anyone.
VITE_EMBEDDED_CHECKOUT=false
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
